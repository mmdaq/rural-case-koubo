# ============================================================
# .env 模板 —— 复制为 .env 并填写真实值（.env 不要提交到 Git）
# ============================================================

# QQ 邮箱 SMTP 授权码（非登录密码！）
# 获取方式：QQ邮箱 → 设置 → 账户 → 开启 SMTP 服务 → 生成授权码
MAIL_SENDER=your_account@qq.com
MAIL_AUTH_CODE=your_smtp_auth_code
MAIL_RECEIVERS=385096659@qq.com

# LLM API Key（DeepSeek / OpenAI 兼容接口）
LLM_API_KEY=

# LLM 接口地址与模型（可覆盖 config.yaml）
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
